@model NembotKamgueGyldas.Models.Auteur

<div class="container mt-5">
    <h1 class="text-center text-primary">📝 Ajouter un Auteur</h1>
    <form asp-action="Create" method="post" class="bg-light p-4 rounded shadow">
        <div class="mb-3">
            <label for="Nom" class="form-label fw-bold">Nom</label>
            <input asp-for="Nom" class="form-control" placeholder="Entrez le nom" />
        </div>
        <div class="mb-3">
            <label for="Prenom" class="form-label fw-bold">Prénom</label>
            <input asp-for="Prenom" class="form-control" placeholder="Entrez le prénom" />
        </div>
        <div class="mb-3">
            <label for="Date_Naissance" class="form-label fw-bold">Date de Naissance</label>
            <input asp-for="Date_Naissance" type="date" class="form-control" />
        </div>
        <div class="text-center">
            <button type="submit" class="btn btn-success btn-lg">✅ Créer</button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">⬅️ Retour</a>
        </div>
    </form>
</div>
